<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Every product container pack supplies these pins for release and integration images. -->
  <ItemGroup Condition="'$(EnableSdkContainerSupport)' == 'true'
      and '$(AgentweaverImageSourceSha)' != ''
      and '$(AgentweaverImageSourceTree)' != ''
      and '$(AgentweaverImageVersion)' != ''">
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(AgentweaverImageSourceSha)" />
    <ContainerLabel Include="io.agentweaver.source-tree" Value="$(AgentweaverImageSourceTree)" />
    <ContainerLabel Include="org.opencontainers.image.version" Value="$(AgentweaverImageVersion)" />
  </ItemGroup>
</Project>
