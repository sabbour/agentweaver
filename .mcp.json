{
  "mcpServers": {
    "agentweaver_local": {
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "apps/Agentweaver.Mcp",
        "--",
        "--stdio"
      ],
      "env": {
        "AGENTWEAVER_API_URL": "http://localhost:5000"
      }
    },
    "squad_state": {
      "command": "npx",
      "args": [
        "-y",
        "@bradygaster/squad-cli@0.12.0",
        "state-mcp"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    }
  }
}
