{
  "name": "agentweaver",
  "private": true,
  "scripts": {
    "start": "node scripts/azure/cli.mjs dev --no-browser",
    "dev": "node scripts/azure/cli.mjs dev --no-browser",
    "setup": "node scripts/azure/cli.mjs dev --setup",
    "azure:deploy": "node scripts/azure/cli.mjs deploy",
    "azure:upgrade": "node scripts/azure/cli.mjs upgrade",
    "azure:release": "node scripts/azure/cli.mjs release",
    "azure:verify": "node scripts/azure/cli.mjs verify",
    "azure:dev": "node scripts/azure/cli.mjs dev",
    "dev:web": "npm --prefix apps/web run build && npm --prefix apps/web run dev",
    "dev:api": "dotnet build apps/Agentweaver.Api -c Release -p:CopilotSkipCliDownload=true && dotnet run --project apps/Agentweaver.Api -c Release --no-build -p:CopilotSkipCliDownload=true",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  }
}
