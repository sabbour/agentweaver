{
  "name": "agentweaver",
  "private": true,
  "scripts": {
    "start": "node scripts/azure/cli.mjs dev --no-browser",
    "dev": "node scripts/azure/cli.mjs dev --no-browser",
    "dev:open": "node scripts/azure/cli.mjs dev",
    "setup": "node scripts/azure/cli.mjs dev --setup",
    "azure:provision-infra": "node scripts/azure/cli.mjs provision-infra",
    "azure:setup-entra-app": "node scripts/azure/cli.mjs setup-entra-app",
    "azure:deploy-from-local": "node scripts/azure/cli.mjs deploy-from-local",
    "azure:deploy-from-commit": "node scripts/azure/cli.mjs deploy-from-commit",
    "azure:deploy-from-release": "node scripts/azure/cli.mjs deploy-from-release",
    "azure:release": "node scripts/azure/cli.mjs release",
    "azure:verify": "node scripts/azure/cli.mjs verify",
    "dev:web": "npm --prefix apps/web run build && npm --prefix apps/web run dev",
    "dev:api": "dotnet build apps/Agentweaver.Api -c Release -p:CopilotSkipCliDownload=true && dotnet run --project apps/Agentweaver.Api -c Release --no-build -p:CopilotSkipCliDownload=true",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:render-diagrams": "node scripts/docs/render-diagrams.mjs",
    "docs:check-diagrams": "node scripts/docs/render-diagrams.mjs --check",
    "test:docs-diagrams": "node --test scripts/docs/*.test.mjs",
    "test:mcp-smoke": "npm --prefix scripts/mcp-harness run smoke --",
    "deps:ensure": "node scripts/ci/shared-deps.mjs ensure",
    "deps:invalidate": "node scripts/ci/shared-deps.mjs invalidate",
    "deps:verify": "node scripts/ci/shared-deps.mjs verify",
    "validate:layer": "node scripts/ci/validate.mjs --profile layer",
    "validate:full": "node scripts/ci/validate.mjs --profile full",
    "demo:record": "node scripts/demo-recording/cli.mjs",
    "changeset": "changeset add",
    "changeset:status": "changeset status --verbose",
    "changeset:check": "node scripts/changesets/check.mjs",
    "version:check": "node scripts/changesets/check-version.mjs",
    "release:plan": "node scripts/changesets/plan-release.mjs",
    "release:prepare": "node scripts/changesets/prepare-release.mjs",
    "release:publish": "node scripts/azure/cli.mjs publish-release",
    "release:sync-dev": "node scripts/changesets/sync-dev.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1"
  },
  "version": "0.28.4"
}
