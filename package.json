{
  "name": "agentweaver-v1-tooling",
  "private": true,
  "scripts": {
    "release:validate": "node scripts/release/validate.mjs releases/foundation.json",
    "release:plan": "node scripts/release/plan.mjs releases/foundation.json",
    "release:apply": "node scripts/release/apply.mjs artifacts/release/plan.json releases/foundation.json",
    "release:pack": "node scripts/release/pack.mjs releases/foundation.json",
    "test:release": "node --test scripts/release/tests/*.test.mjs",
    "test:azure": "node --test scripts/azure/tests/*.test.mjs",
    "test:harness": "node --test scripts/harness-shared/test/*.test.mjs scripts/api-harness/test/*.test.mjs scripts/ui-harness/test/*.test.mjs scripts/mcp-harness/test/*.test.mjs",
    "test:harness:api": "node --test scripts/harness-shared/test/*.test.mjs scripts/api-harness/test/*.test.mjs",
    "test:harness:ui": "node --test scripts/harness-shared/test/*.test.mjs scripts/ui-harness/test/*.test.mjs",
    "test:harness:mcp": "node --test scripts/harness-shared/test/*.test.mjs scripts/mcp-harness/test/*.test.mjs",
    "coverage:dotnet": "node scripts/coverage/dotnet.mjs",
    "coverage:node": "node scripts/coverage/node.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "docs:build-flagship-specs": "node scripts/docs/build-flagship-specs.mjs",
    "docs:render-diagrams": "node scripts/docs/render-diagrams.mjs",
    "docs:check-diagrams": "node scripts/docs/render-diagrams.mjs --check",
    "docs:check-flagship-diagrams": "node scripts/docs/validate-flagship-diagrams.mjs",
    "docs:check-links": "node scripts/docs/check-docs.mjs --links",
    "docs:check-drift": "node scripts/docs/check-docs.mjs --drift",
    "test:docs-diagrams": "node --test scripts/docs/*.test.mjs"
  }
}
