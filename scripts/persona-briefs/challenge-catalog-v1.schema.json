{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentweaver.dev/schemas/persona-briefs/challenge-catalog-v1.schema.json",
  "title": "Agentweaver harness challenge catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogVersion",
    "generatedNote",
    "authority",
    "tiers",
    "releasePolicy",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "agentweaver.challenge-catalog/v1" },
    "catalogVersion": { "const": 1 },
    "generatedNote": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose", "environmentOwner", "forbiddenCatalogAuthority"],
      "properties": {
        "prose": { "const": "quoted-untrusted-data" },
        "environmentOwner": { "const": "harness-runtime" },
        "forbiddenCatalogAuthority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hosts",
              "credentials",
              "project-ids",
              "commands",
              "approvals",
              "github-actions",
              "deployment-mutations"
            ]
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/tier" }
    },
    "releasePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representativeChallengeId",
        "runFullCatalogPerRelease",
        "focusedFeatureAcceptanceRequired",
        "surfaceSelection",
        "abnormalResultContract"
      ],
      "properties": {
        "representativeChallengeId": { "type": "string", "minLength": 1 },
        "runFullCatalogPerRelease": { "const": false },
        "focusedFeatureAcceptanceRequired": { "const": true },
        "surfaceSelection": { "const": "affected-surfaces-fail-closed" },
        "abnormalResultContract": { "const": "agentweaver.release-acceptance-result/v1" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/challenge" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "fullCatalog",
        "wallClockMinutesMax",
        "aiCreditsMax",
        "maxConcurrentAgents",
        "maxChildRuns"
      ],
      "properties": {
        "id": { "enum": ["fast-smoke", "release-integration", "nightly", "manual"] },
        "description": { "type": "string", "minLength": 1 },
        "fullCatalog": { "const": false },
        "wallClockMinutesMax": { "type": "number", "exclusiveMinimum": 0 },
        "aiCreditsMax": { "type": "number", "exclusiveMinimum": 0 },
        "maxConcurrentAgents": { "type": "integer", "minimum": 1 },
        "maxChildRuns": { "type": "integer", "minimum": 1 }
      }
    },
    "personaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surfaces"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["api", "ui", "mcp"] }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["api", "ui", "mcp"] }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["api", "ui", "mcp"] }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "statement", "requiredEvidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$" },
        "priority": { "enum": ["P0", "P1"] },
        "statement": { "type": "string", "minLength": 1 },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceType" }
        }
      }
    },
    "evidenceType": {
      "enum": [
        "deployed-release-revision",
        "project-record",
        "run-record",
        "outcome-spec-revision",
        "work-plan",
        "topology-record",
        "event-query",
        "surface-transcript",
        "artifact-file",
        "artifact-hash",
        "repository-revision",
        "memory-record",
        "decision-record",
        "review-record",
        "preview-publication",
        "preview-validation",
        "source-manifest",
        "backlog-record",
        "usage-record",
        "cleanup-record",
        "deployment-record",
        "authorization-record",
        "structural-validation"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTypes", "requiredBindings", "structuralEvidenceCanSatisfy"],
      "properties": {
        "requiredTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceType" }
        },
        "requiredBindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["revision", "project", "run", "artifact", "surface"] }
        },
        "structuralEvidenceCanSatisfy": { "type": "boolean" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "provenance", "independentValidation"],
      "properties": {
        "required": { "const": true },
        "provenance": { "const": "harness-owned-disposable-project" },
        "independentValidation": { "const": true }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibleTiers", "defaultTier", "requiredOnRelease", "selectionTags"],
      "properties": {
        "eligibleTiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["fast-smoke", "release-integration", "nightly", "manual"] }
        },
        "defaultTier": { "enum": ["fast-smoke", "release-integration", "nightly", "manual"] },
        "requiredOnRelease": { "type": "boolean" },
        "selectionTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "summary",
        "family",
        "tags",
        "executionContract",
        "completionRequired",
        "personaRefs",
        "surfaces",
        "claims",
        "seams",
        "prerequisiteCapabilities",
        "completionRequirements",
        "riskClass",
        "evidence",
        "publication",
        "cadence",
        "featureRefs",
        "unsupportedClassifications",
        "lastVerifiedRelease"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$" },
        "version": { "const": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "executionContract": { "enum": ["dynamic-human-v1", "structural-observability-v1"] },
        "completionRequired": { "type": "boolean" },
        "personaRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/personaRef" }
        },
        "surfaces": { "$ref": "#/$defs/surfaces" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        },
        "seams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prerequisiteCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "completionRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "riskClass": { "enum": ["read-only", "reversible-owned", "destructive-owned", "staging-only"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "preview": { "$ref": "#/$defs/preview" },
        "publication": { "enum": ["none", "internal-artifact-only"] },
        "cadence": { "$ref": "#/$defs/cadence" },
        "featureRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unsupportedClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "capability-not-advertised",
              "surface-not-enabled",
              "provider-not-configured",
              "environment-not-eligible"
            ]
          }
        },
        "lastVerifiedRelease": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
