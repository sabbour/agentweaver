{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "web",
    "namespace": "agentweaver-v1-p0",
    "labels": {
      "app.kubernetes.io/name": "web",
      "agentweaver.io/service": "web"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app.kubernetes.io/name": "web"
    },
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "targetPort": "http",
        "protocol": "TCP"
      }
    ]
  }
}
