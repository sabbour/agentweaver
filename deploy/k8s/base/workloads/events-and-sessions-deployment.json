{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "events-and-sessions",
    "namespace": "agentweaver",
    "labels": {
      "app.kubernetes.io/name": "events-and-sessions",
      "agentweaver.io/service": "events-and-sessions"
    }
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "events-and-sessions"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "events-and-sessions",
          "agentweaver.io/service": "events-and-sessions",
          "agentweaver.io/workload": "events-and-sessions",
          "azure.workload.identity/use": "true"
        }
      },
      "spec": {
        "serviceAccountName": "events-and-sessions",
        "automountServiceAccountToken": true,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1654,
          "runAsGroup": 1654,
          "fsGroup": 1654,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "64Mi"
            }
          },
          {
            "name": "tls",
            "secret": {
              "secretName": "events-and-sessions-tls",
              "optional": false,
              "defaultMode": 288,
              "items": [
                {
                  "key": "tls.crt",
                  "path": "tls.crt"
                },
                {
                  "key": "tls.key",
                  "path": "tls.key"
                }
              ]
            }
          }
        ],
        "containers": [
          {
            "name": "events-and-sessions",
            "image": "ghcr.io/sabbour/agentweaver.eventsandsessions:receipt-pinned",
            "imagePullPolicy": "IfNotPresent",
            "ports": [
              {
                "name": "https",
                "containerPort": 8443,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "ASPNETCORE_URLS",
                "value": "https://+:8443"
              },
              {
                "name": "EventsAndSessions__Cost__Copilot__OptionsRevision",
                "value": "p1-v1.0.0"
              },
              {
                "name": "ASPNETCORE_Kestrel__Certificates__Default__Path",
                "value": "/var/run/events-and-sessions-tls/tls.crt"
              },
              {
                "name": "ASPNETCORE_Kestrel__Certificates__Default__KeyPath",
                "value": "/var/run/events-and-sessions-tls/tls.key"
              }
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "events-and-sessions-runtime-config",
                  "optional": false
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "tls",
                "mountPath": "/var/run/events-and-sessions-tls",
                "readOnly": true
              }
            ],
            "livenessProbe": {
              "httpGet": {
                "path": "/health/live",
                "port": "https",
                "scheme": "HTTPS"
              },
              "periodSeconds": 10,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/health/ready",
                "port": "https",
                "scheme": "HTTPS"
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            }
          }
        ]
      }
    }
  }
}
