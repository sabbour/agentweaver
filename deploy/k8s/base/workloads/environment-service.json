{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "environment",
    "namespace": "agentweaver",
    "labels": {
      "app.kubernetes.io/name": "environment",
      "agentweaver.io/service": "environment"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app.kubernetes.io/name": "environment"
    },
    "ports": [
      {
        "name": "https",
        "port": 8443,
        "targetPort": "https",
        "protocol": "TCP"
      }
    ]
  }
}
