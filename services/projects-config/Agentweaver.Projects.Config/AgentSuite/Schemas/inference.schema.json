{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.agent-primitives.dev/schema/v0.5/inference.schema.json",
  "title": "Inference capability requirements",
  "$comment": "Full conformance also requires outputTokens <= contextTokens, checked by semantic validation. Standard JSON Schema cannot compare sibling numeric values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "contextTokens", "outputTokens", "streaming", "toolCalling"],
  "properties": {
    "api": {"const": "openai-chat-completions-v1"},
    "contextTokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "outputTokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "streaming": {"type": "boolean"},
    "toolCalling": {"type": "boolean"}
  }
}
