# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
.squad/.cache/

# Node
node_modules/
npm-debug.log*

# TypeScript build output
dist/
*.tsbuildinfo

# Misc
.DS_Store
.impeccable/

# Build output
apps/*/bin/
apps/*/obj/
packages/*/bin/
packages/*/obj/
# Un-ignore bundled mxc executor source binaries (MIT-licensed, ships with the package)
!packages/Agentweaver.SandboxExec/bin/
!packages/Agentweaver.SandboxExec/bin/arm64/
!packages/Agentweaver.SandboxExec/bin/arm64/**
!packages/Agentweaver.SandboxExec/bin/x64/
!packages/Agentweaver.SandboxExec/bin/x64/**
# Re-ignore .NET build output subdirectories inside the SandboxExec bin/ folder
packages/Agentweaver.SandboxExec/bin/Debug/
packages/Agentweaver.SandboxExec/bin/Release/
tests/*/bin/
tests/*/obj/

# Node.js
apps/web/node_modules/
apps/web/dist/

# .NET user files
*.user
*.suo
.vs/
*.userprefs

# Rider
.idea/

# Environment
.env
.env.local
apps/Agentweaver.Api/appsettings.Development.json

obj/

# Test results
[Tt]est[Rr]esults/

# Vite build cache
apps/web/.vite/

# E2E test generated artifacts
tests/e2e/node_modules/
tests/e2e/playwright-report/
tests/e2e/test-results/
.worktrees/

# Local-only security assessment findings (not to be committed/published)
.security/

# Azure toolchain params files (may contain resource names/secrets); the
# tracked template is scripts/azure/params.example.json
scripts/azure/params.*.json
!scripts/azure/params.example.json

# Azure deploy toolchain: kustomize build scratch directories (written at
# deploy time by lib/kustomize.mjs's writeOverlay(), and by its tests) --
# never meant to be committed, only cleaned up on a best-effort basis.
scripts/azure/steps/.rendered/
scripts/azure/tests/.scratch-*/

