{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Agentweaver",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/azure/cli.mjs",
        "dev",
        "--no-browser"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
