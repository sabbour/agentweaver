{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Agentweaver": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss ",
        "SingleLine": true
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Runs": {
    "AllowedRepositoryRoots": []
  },
  "Sandbox": {
    "AgentExecutionMode": "in-api",
    "AgentHost": {
      "Port": 8088,
      "Scheme": "https",
      "A2APath": "/a2a/agent",
      "HttpTimeout": "00:02:00",
      "A2AStreaming": {
        "TotalTurnTimeout": "01:10:00",
        "ReadIdleTimeout": "00:20:00"
      }
    },
    "Kubernetes": {
      "Namespace": "agentweaver",
      "TimeoutSeconds": 600
    }
  },
  "Auth": {
    "GitHub": {
      "AllowedOrg": "microsoft",
      "Scopes": "repo read:user read:org copilot"
    },
    "OAuth": {
      "SigningKey": "",
      "Issuer": "",
      "Audience": "",
      "AllowedRedirectUriPrefixes": []
    }
  },
  "Workspace": {
    "Provider": "local",
    "Local": {
      "RootPath": ""
    }
  },
  "Providers": {
    "GitHubCopilot": {
      "RuntimeCliPath": ""
    }
  },
  "Generation": {
    "Model": "gpt-5.6-sol"
  },
  "AllowedHosts": "*"
}
