<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Agentweaver.Api.Data\Agentweaver.Api.Data.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.Domain\Agentweaver.Domain.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.SandboxFs\Agentweaver.SandboxFs.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.AgentRuntime\Agentweaver.AgentRuntime.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.Squad\Agentweaver.Squad.csproj" />
    <!-- spec-018 P2: Postgres migrations assembly. Referenced so the DLL is copied to output
         and can be loaded at runtime via MigrationsAssembly("Agentweaver.Api.Migrations.Postgres"). -->
    <ProjectReference Include="..\Agentweaver.Api.Migrations.Postgres\Agentweaver.Api.Migrations.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- spec-006 (api-harness): serves a machine-readable OpenAPI contract so the LLM-driven curl
         harness can discover routes and request/response shapes instead of relying on hand-wrapped
         SDK-style subcommands. Built-in package (no Swashbuckle needed) since this project targets
         net10.0, which supports AddOpenApi()/MapOpenApi(). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Security override: Microsoft.AspNetCore.OpenApi 10.0.10 pulls the vulnerable Microsoft.OpenApi
         2.0.0 transitively (GHSA-v5pm-xwqc-g5wc, stack-overflow DoS on circular schema references).
         Pin the patched 2.x line directly, same override pattern used for SQLitePCLRaw above. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- Security override: force the patched native SQLite binary (bundles SQLite 3.50.3) over the
         vulnerable 2.1.11 pulled transitively by Microsoft.Data.Sqlite / EF Core Sqlite. Fixes
         GHSA-2m69-gcr7-jv3q (NU1903). The lib.e_sqlite3 package is intentionally separable from the
         managed core/provider, so bumping only the native binary is the supported way to patch. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.Query" Version="1.7.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SDK PermissionDecision/PermissionRequest Rpc types are marked [Experimental("GHCP001")];
         suppress since the tool-less classifiers intentionally use them for deny-by-default
         OnPermissionRequest handlers (mirrors Agentweaver.AgentRuntime.csproj). -->
    <NoWarn>$(NoWarn);CS0419;CS1570;CS1573;CS1574;CS1587;CS1591;CS1734;GHCP001</NoWarn>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <UserSecretsId>agentweaver-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agentweaver.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GitHub Copilot agent definition materialized into each new project's
         .github/agents/. It is a generated, byte-identical copy of the repo's
         .github/agents/agentweaver.agent.md (see scripts/gen-docs.mjs); a unit test
         and CI assert the two never drift. -->
    <EmbeddedResource Include="Projects\Templates\agentweaver.agent.md" LogicalName="Agentweaver.Api.Projects.Templates.agentweaver.agent.md" />
  </ItemGroup>

</Project>
