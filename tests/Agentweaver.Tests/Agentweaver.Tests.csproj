<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Allow the test project to reference ASP.NET Core types without the Web SDK -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <!-- SDK PermissionDecision Rpc types are marked [Experimental("GHCP001")]; suppress in tests. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
    <!-- SSH.NET 2025.1.0 has GHSA-q939-rpr3-3284 (high); it is a transitive test-only dependency
         with no network exposure in our test suite. Suppress until a patched version is available.
         NU1903 = high-severity audit warning (treated as error by default in .NET 8+). -->
    <NuGetAuditSuppress>https://github.com/advisories/GHSA-q939-rpr3-3284</NuGetAuditSuppress>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GHSA-q939-rpr3-3284 (NU1903): SSH.NET 2025.1.0 arrives transitively through
      Testcontainers.PostgreSql. Upstream has not shipped a fixed release yet - 2025.1.0 is
      still the latest published version - so there is nothing to upgrade to, and
      TreatWarningsAsErrors turns the audit warning into a restore failure that blocks every
      .NET job in CI.

      The advisory is a path-traversal in ScpClient.Download's recursive SCP download, which
      only bites a client that downloads a directory tree from an untrusted SCP server. This
      is a test-only dependency: no product project resolves SSH.NET (it appears in exactly
      one lock file, this project's) and nothing in the repository references ScpClient or
      Renci.SshNet. Testcontainers pulls it in for its optional "remote Docker over SSH"
      transport, which the suite never configures.

      Tracked by #762 - remove this suppression as soon as a patched SSH.NET is released.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\apps\web\src\contracts\workflowNodeTypes.json"
             Link="Contracts\workflowNodeTypes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CatalogFixtures\workflows\shadow_target.yaml" LogicalName="Agentweaver.Tests.CatalogFixtures.workflows.shadow_target.yaml" />
    <EmbeddedResource Include="CatalogFixtures\duplicate-workflows\shadow_target_invalid.yaml" LogicalName="Agentweaver.Tests.CatalogDuplicateFixtures.workflows.shadow_target_invalid.yaml" />
    <EmbeddedResource Include="CatalogFixtures\duplicate-workflows\shadow_target_valid.yaml" LogicalName="Agentweaver.Tests.CatalogDuplicateFixtures.workflows.shadow_target_valid.yaml" />
    <EmbeddedResource Include="CatalogFixtures\blueprints\malformed_role.json" LogicalName="Agentweaver.Tests.CatalogFixtures.blueprints.malformed_role.json" />
    <EmbeddedResource Include="CatalogFixtures\roles\malformed_role.json" LogicalName="Agentweaver.Tests.CatalogFixtures.roles.malformed_role.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Agentweaver.Domain\Agentweaver.Domain.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.SandboxExec\Agentweaver.SandboxExec.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.SandboxFs\Agentweaver.SandboxFs.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.AgentRuntime\Agentweaver.AgentRuntime.csproj" />
    <ProjectReference Include="..\..\apps\Agentweaver.Api\Agentweaver.Api.csproj" />
    <ProjectReference Include="..\..\apps\Agentweaver.AgentHost\Agentweaver.AgentHost.csproj">
      <!-- Alias avoids CS0433: AgentHost and Api both emit a top-level 'Program' type. -->
      <Aliases>agenthost</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\apps\Agentweaver.Web\Agentweaver.Web.csproj">
      <!-- Alias avoids CS0433: Web and Api both emit a top-level 'Program' type. -->
      <Aliases>agentweaverweb</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\apps\Agentweaver.Mcp\Agentweaver.Mcp.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.Squad\Agentweaver.Squad.csproj" />
    <ProjectReference Include="..\..\apps\Agentweaver.Api.Migrations.Postgres\Agentweaver.Api.Migrations.Postgres.csproj" />
  </ItemGroup>

</Project>
