<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The resolver test checks that accepted GitHub selections preserve this reviewed catalog revision. -->
  <ItemGroup>
    <None Include="..\..\deploy\k8s\provider-catalogs\projects-config-provider-catalog.snapshot.json"
          Link="provider-catalog\projects-config-provider-catalog.snapshot.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\k8s\runtime-configs\orchestrator-runtime-config.json"
          Link="runtime-configs\orchestrator-runtime-config.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <ProjectReference Include="..\..\services\orchestrator\Agentweaver.Orchestrator\Agentweaver.Orchestrator.csproj" />
    <ProjectReference Include="..\..\services\orchestrator\Agentweaver.Orchestrator.Core\Agentweaver.Orchestrator.Core.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.Providers\Agentweaver.Providers.csproj" />
    <ProjectReference Include="..\..\packages\Agentweaver.SourceControl\Agentweaver.SourceControl.csproj" />
  </ItemGroup>
</Project>
