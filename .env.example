# Local API development overrides (optional).
# Prefer `dotnet user-secrets` for this value:
#   cd apps/Agentweaver.Api
#   dotnet user-secrets set "Auth:GitHub:ClientSecret" "<your-oauth-app-client-secret>"
Auth__GitHub__ClientSecret=<your-oauth-app-client-secret>

# Optional local Application Insights / Azure Monitor observability.
# Put real values in ignored .env.local or API user-secrets, never in this file.
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-application-insights-connection-string>
APPLICATIONINSIGHTS_WORKSPACE_ID=<your-log-analytics-workspace-id>

# Optional generation model overrides. Defaults to gpt-5.4 for blueprint, workflow,
# and coordinator outcome-spec generation without changing normal agent run models.
# Generation__Model=gpt-5.4
# Generation__BlueprintModel=gpt-5.4
# Generation__WorkflowModel=gpt-5.4
# Generation__OutcomeSpecModel=gpt-5.4
