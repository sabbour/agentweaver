{
  "pages": [
    "docs/index.md",
    "docs/guide/build-and-use.md",
    "docs/guide/testing.md",
    "docs/guide/azure-acceptance.md",
    "docs/diagrams/README.md",
    "docs/architecture/overview.md",
    "docs/architecture/events-sessions.md",
    "docs/architecture/providers-models.md",
    "docs/architecture/projects-config.md",
    "docs/architecture/environment-egress.md",
    "docs/architecture/identity-secrets.md",
    "docs/architecture/persistence-objects.md",
    "docs/architecture/telemetry.md",
    "docs/architecture/design/provider-seams.md",
    "docs/architecture/azure.md",
    "docs/reference/contracts.md",
    "docs/reference/releases.md"
  ],
  "rules": [
    {
      "name": "Orchestrator workflow catalogs",
      "sourcePrefixes": [
        "services/orchestrator/Agentweaver.Orchestrator.Core/"
      ],
      "required": [
        "docs/architecture/design/orchestration.md",
        "docs/architecture/design/services-and-release.md",
        "docs/guide/testing.md"
      ]
    },
    {
      "name": "Orchestrator coordination owner",
      "sourcePrefixes": [
        "services/orchestrator/Agentweaver.Orchestrator/"
      ],
      "required": [
        "docs/architecture/design/sessions-and-coordination.md",
        "docs/architecture/design/services-and-release.md",
        "docs/architecture/events-sessions.md",
        "docs/reference/contracts.md",
        "docs/guide/testing.md",
        "docs/diagrams/src/flagship/v1-sessions-journal.json"
      ]
    },
    {
      "name": "foundation architecture",
      "sourcePrefixes": [
        "packages/Agentweaver.Abstractions/ProviderContracts.cs",
        "packages/Agentweaver.Abstractions/SessionsContracts.cs",
        "packages/Agentweaver.Abstractions/SecretContracts.cs",
        "packages/Agentweaver.Abstractions/ObjectStore.cs",
        "packages/Agentweaver.Providers/",
        "packages/Agentweaver.Identity/",
        "packages/Agentweaver.Secrets.AzureKeyVault/",
        "packages/Agentweaver.Persistence.Postgres/",
        "packages/Agentweaver.ObjectStore.AzureBlob/",
        "packages/Agentweaver.Telemetry/",
        "packages/Agentweaver.Telemetry.AzureMonitor/",
        "services/identity/Agentweaver.Identity.Broker/",
        "services/events-and-sessions/",
        "services/orchestrator/Agentweaver.Orchestrator/",
        "tools/Agentweaver.FoundationProbe/"
      ],
      "required": [
        "docs/architecture/overview.md",
        "docs/diagrams/src/flagship/v1-foundation-dependencies.json"
      ]
    },
    {
      "name": "Events & Sessions journal",
      "sourcePrefixes": [
        "packages/Agentweaver.Abstractions/AddressedMessageContracts.cs",
        "packages/Agentweaver.Abstractions/SessionsContracts.cs",
        "services/events-and-sessions/"
      ],
      "required": [
        "docs/architecture/events-sessions.md",
        "docs/architecture/providers-models.md",
        "docs/reference/contracts.md",
        "docs/guide/testing.md",
        "docs/diagrams/src/flagship/v1-sessions-journal.json"
      ]
    },
    {
      "name": "provider resolution",
      "sourcePrefixes": [
        "packages/Agentweaver.Abstractions/ProviderContracts",
        "packages/Agentweaver.Providers/"
      ],
      "required": [
        "docs/architecture/providers-models.md",
        "docs/diagrams/src/flagship/v1-provider-resolution.json"
      ]
    },
    {
      "name": "Workspace volumes and Azure Files CSI",
      "sourcePrefixes": [
        "packages/Agentweaver.Abstractions/StorageContracts.cs",
        "packages/Agentweaver.Providers.Storage.AzureFiles/",
        "tests/Agentweaver.Providers.Storage.AzureFiles.Tests/",
        "tests/Agentweaver.Providers.Tests/WorkspaceVolumeContractsTests.cs"
      ],
      "required": [
        "docs/architecture/design/provider-seams.md",
        "docs/guide/testing.md",
        "docs/diagrams/src/flagship/v1-storage-volume-provisioning.json"
      ]
    },
    {
      "name": "Projects and Config",
      "sourcePrefixes": [
        "services/projects-config/"
      ],
      "required": [
        "docs/architecture/projects-config.md"
      ]
    },
    {
      "name": "Environment egress intent",
      "sourcePrefixes": [
        "packages/Agentweaver.Abstractions/NetworkPolicyContracts.cs",
        "services/environment/"
      ],
      "required": [
        "docs/architecture/environment-egress.md",
        "docs/architecture/overview.md",
        "docs/architecture/design/provider-seams.md",
        "docs/guide/testing.md"
      ]
    },
    {
      "name": "Identity and secrets",
      "sourcePrefixes": [
        "packages/Agentweaver.Identity/",
        "packages/Agentweaver.Secrets.AzureKeyVault/",
        "services/identity/Agentweaver.Identity.Broker/"
      ],
      "required": [
        "docs/architecture/identity-secrets.md",
        "docs/reference/contracts.md",
        "docs/diagrams/src/flagship/v1-identity-redemption.json"
      ]
    },
    {
      "name": "PostgreSQL and object storage",
      "sourcePrefixes": [
        "packages/Agentweaver.Persistence.Postgres/",
        "packages/Agentweaver.ObjectStore.AzureBlob/"
      ],
      "required": [
        "docs/architecture/persistence-objects.md",
        "docs/diagrams/src/flagship/v1-outbox-inbox.json",
        "docs/diagrams/src/flagship/v1-outbox-relay.json"
      ]
    },
    {
      "name": "Telemetry",
      "sourcePrefixes": [
        "packages/Agentweaver.Telemetry/"
      ],
      "required": [
        "docs/architecture/telemetry.md",
        "docs/architecture/overview.md",
        "docs/diagrams/src/flagship/v1-foundation-dependencies.json"
      ]
    },
    {
      "name": "Azure infrastructure and probe",
      "sourcePrefixes": [
        "infra/bicep/",
        "deploy/k8s/",
        "scripts/azure/",
        "tools/Agentweaver.FoundationProbe/"
      ],
      "required": [
        "docs/architecture/azure.md",
        "docs/reference/contracts.md",
        "docs/guide/azure-acceptance.md",
        "docs/diagrams/src/flagship/v1-azure-foundation.json",
        "docs/diagrams/src/flagship/v1-azure-acceptance.json"
      ]
    },
    {
      "name": "Component releases",
      "sourcePrefixes": [
        "scripts/release/",
        "releases/"
      ],
      "required": [
        "docs/reference/releases.md"
      ]
    },
    {
      "name": "Sequence diagram schema",
      "sourcePrefixes": [
        "docs/diagrams/src/sequence-spec.schema.json"
      ],
      "required": [
        "docs/diagrams/README.md",
        "docs/diagrams/src/sequence-spec.schema.json"
      ]
    }
  ]
}
