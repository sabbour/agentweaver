{
  "$schema": "./sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Approve vs Request Changes",
  "alt": "Approve vs Request Changes: User, API, Pending Request Store, Workflow, Run Store, Merge, Agent",
  "participants": [
    {
      "id": "User",
      "label": "User",
      "icon": "globe",
      "badge": {
        "text": "Client",
        "tone": "lavender"
      }
    },
    {
      "id": "API",
      "label": "API",
      "icon": "server",
      "badge": {
        "text": "Service",
        "tone": "green"
      }
    },
    {
      "id": "Pending",
      "label": "Pending Request Store",
      "icon": "database",
      "badge": {
        "text": "Data",
        "tone": "teal"
      }
    },
    {
      "id": "Workflow",
      "label": "Workflow",
      "icon": "box",
      "badge": {
        "text": "Component",
        "tone": "neutral"
      }
    },
    {
      "id": "Store",
      "label": "Run Store",
      "icon": "database",
      "badge": {
        "text": "Data",
        "tone": "teal"
      }
    },
    {
      "id": "Merge",
      "label": "Merge",
      "icon": "box",
      "badge": {
        "text": "Component",
        "tone": "neutral"
      }
    },
    {
      "id": "Agent",
      "label": "Agent",
      "icon": "bot",
      "badge": {
        "text": "Runtime",
        "tone": "green"
      }
    }
  ],
  "steps": [
    {
      "type": "message",
      "from": "User",
      "to": "API",
      "label": "approve",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "API",
      "to": "Pending",
      "label": "atomically consume request",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "API",
      "to": "Workflow",
      "label": "send approved decision",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "Workflow",
      "to": "Merge",
      "label": "build MergeInput from stored tree",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "Merge",
      "to": "Store",
      "label": "CAS awaiting_review/committing -> merging",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "Merge",
      "to": "Merge",
      "label": "repository lock + git merge",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "Merge",
      "to": "Store",
      "label": "merged or merge_failed",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "User",
      "to": "API",
      "label": "request changes",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "API",
      "to": "Pending",
      "label": "atomically consume request",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "API",
      "to": "Store",
      "label": "CAS awaiting_review -> in_progress",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "API",
      "to": "Workflow",
      "label": "send revise decision + feedback",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "Workflow",
      "to": "Agent",
      "label": "resume/re-run producer with feedback",
      "line": "solid",
      "arrow": "filled"
    }
  ]
}
