{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentweaver sequence diagram spec",
  "description": "Structured input for native UML-style sequence diagrams generated by scripts/docs/drawio-generator.mjs.",
  "type": "object",
  "required": ["kind", "title", "alt", "autonumber", "participants", "steps"],
  "properties": {
    "kind": { "const": "sequence" },
    "title": { "type": "string", "minLength": 1 },
    "alt": { "type": "string", "minLength": 1 },
    "autonumber": { "type": "boolean" },
    "participants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/participant" } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "badge": {
      "type": "object",
      "required": ["text", "tone"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "enum": ["lavender", "teal", "green", "marigold", "neutral"] }
      }
    },
    "participant": {
      "type": "object",
      "required": ["id", "label", "icon", "badge"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "subLabel": { "type": "string" },
        "icon": { "type": "string", "enum": ["globe", "branch", "route", "window", "server", "bot", "database", "key", "box"] },
        "fluentIcon": { "type": "string" },
        "library": { "type": "string", "enum": ["azure", "kubernetes", "c4", "uml", "flowchart", "bpmn", "networking", "database", "cloud", "agentweaver"] },
        "shape": { "type": "string" },
        "badge": { "$ref": "#/$defs/badge" }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "from", "to", "label", "line", "arrow"],
          "properties": {
            "type": { "const": "message" },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "line": { "type": "string", "enum": ["solid", "dashed"] },
            "arrow": { "type": "string", "enum": ["filled", "open", "cross"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "participant", "action"],
          "properties": {
            "type": { "const": "activation" },
            "participant": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "enum": ["start", "end"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "over", "label"],
          "properties": {
            "type": { "const": "note" },
            "over": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "label": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "operator", "label", "sections"],
          "properties": {
            "type": { "const": "fragment" },
            "operator": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "label": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    }
  }
}
