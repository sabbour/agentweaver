{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Provider resolution and run pinning",
  "alt": "Sequence from the Foundation Probe host through ProviderCatalog and ProviderResolver to resolve probe registrations and pin immutable bindings from supplied target resource IDs and generation. The Orchestrator Core separately resolves and pins its platform-singleton AGT YAML Policy adapter through the same catalog and resolver; that adapter path is not part of the probe sequence.",
  "autonumber": true,
  "participants": [
    {
      "id": "probe-host",
      "label": "Foundation Probe host",
      "subLabel": "ProbeRunner calls ProbeProviderBindings",
      "icon": "server",
      "fluentIcon": "api",
      "badge": { "text": "Host", "tone": "neutral" }
    },
    {
      "id": "provider-catalog",
      "label": "ProviderCatalog",
      "subLabel": "Agentweaver.Providers library",
      "icon": "box",
      "fluentIcon": "package",
      "badge": { "text": "Library", "tone": "teal" }
    },
    {
      "id": "provider-resolver",
      "label": "ProviderResolver",
      "subLabel": "Agentweaver.Providers library",
      "icon": "box",
      "fluentIcon": "workflow",
      "badge": { "text": "Library", "tone": "teal" }
    }
  ],
  "steps": [
    {
      "type": "note",
      "over": ["probe-host", "provider-resolver"],
      "label": "Probe pins supplied resources without provisioning.\nCost has immutable resource/rate pins and pricing.\nNeither a source key nor a Cost pin proves an SDK producer."
    },
    {
      "type": "message",
      "from": "probe-host",
      "to": "probe-host",
      "label": "ProbeProviderBindings.ResolveAndPin(target, nonce)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "probe-host",
      "to": "provider-catalog",
      "label": "ProviderCatalog.Create(registrations, selections)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "provider-catalog",
      "to": "probe-host",
      "label": "ProviderResult<ProviderCatalog>",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "fragment",
      "operator": "alt",
      "label": "Catalog result",
      "sections": [
        {
          "label": "valid catalog",
          "steps": [
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "new ProviderResolver(catalog)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "Resolve(Secrets)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Candidate or resolution failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "Pin(candidate, KeyVaultId, negotiation)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Pinned binding or failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "Resolve(ObjectStore)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Candidate or resolution failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "Pin(candidate, BlobContainerId, negotiation)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Pinned binding or failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "ResolveOrdered(Telemetry)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Ordered candidates or failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "probe-host",
              "to": "provider-resolver",
              "label": "PinOrdered(Telemetry, AppInsightsResourceId)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "provider-resolver",
              "to": "probe-host",
              "label": "Pinned ordered binding or failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "note",
              "over": ["probe-host", "provider-resolver"],
              "label": "Foundation Probe and Orchestrator Core use this resolver. Core pins AGT Policy, not as a probe operation; Knowledge selects one Memory candidate per run."
            }
          ]
        },
        {
          "label": "invalid catalog, resolution, or pin",
          "steps": [
            {
              "type": "message",
              "from": "probe-host",
              "to": "probe-host",
              "label": "Throw operation-specific ProbeException",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        }
      ]
    }
  ]
}
