{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Identity broker secret redemption",
  "alt": "Identity.Broker validates bearer and required claims. Invalid tokens return 401 and invalid requests return 400 without redemption. Valid requests check the exact grant around exact-version Key Vault access and invalidate credentials on failure or after the response. Separate runtime grants do not widen secret redemption or project roles. The auth-first library consumes an independently verified nonce before native SDK binding. After SDK preparation it compares the current registration, verifies the observe grant, and checks lifetimes and cancellation immediately before session.create. The validated bearer and observe credential protect immutable Orchestrator source writes. Events accepts only the source receipt reference for accounting. The combined local harness is not cloud deployment or paid model proof.",
  "autonumber": true,
  "participants": [
    {
      "id": "identity-broker",
      "label": "Identity.Broker",
      "subLabel": "Validated subject; separate runtime nonce store",
      "icon": "server",
      "fluentIcon": "identity",
      "badge": {
        "text": "Host",
        "tone": "neutral"
      }
    },
    {
      "id": "authorized-redemption",
      "label": "AuthorizedSecretRedemption",
      "subLabel": "Agentweaver.Identity library",
      "icon": "box",
      "fluentIcon": "security",
      "badge": {
        "text": "Library",
        "tone": "teal"
      }
    },
    {
      "id": "keyvault-adapter",
      "label": "AzureKeyVaultSecretRedemption",
      "subLabel": "Agentweaver.Secrets.AzureKeyVault library",
      "icon": "box",
      "fluentIcon": "identity",
      "badge": {
        "text": "Library",
        "tone": "teal"
      }
    },
    {
      "id": "key-vault",
      "label": "Azure Key Vault",
      "subLabel": "External resource; exact secret version",
      "icon": "key",
      "library": "azure",
      "shape": "image;image=img/lib/azure2/security/Key_Vaults.svg;imageAspect=1",
      "badge": {
        "text": "Azure resource",
        "tone": "green"
      }
    }
  ],
  "steps": [
    {
      "type": "fragment",
      "operator": "alt",
      "label": "Bearer and request validation",
      "sections": [
        {
          "label": "invalid bearer or required claims",
          "steps": [
            {
              "type": "message",
              "from": "identity-broker",
              "to": "identity-broker",
              "label": "HTTP 401; no wrapper or backend call",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        },
        {
          "label": "valid bearer; invalid request",
          "steps": [
            {
              "type": "message",
              "from": "identity-broker",
              "to": "identity-broker",
              "label": "HTTP 400; no wrapper or Key Vault call",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        },
        {
          "label": "valid bearer and exact request",
          "steps": [
            {
              "type": "message",
              "from": "identity-broker",
              "to": "authorized-redemption",
              "label": "RedeemAsync(TrustedActorContext, exact request)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "authorized-redemption",
              "to": "authorized-redemption",
              "label": "FindGrantsAsync(actor, exact request)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "authorized-redemption",
              "to": "authorized-redemption",
              "label": "One fresh active exact grant / denial",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "fragment",
              "operator": "alt",
              "label": "Fresh exact-grant precheck",
              "sections": [
                {
                  "label": "no active exact grant",
                  "steps": [
                    {
                      "type": "message",
                      "from": "authorized-redemption",
                      "to": "identity-broker",
                      "label": "Denied before backend",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "identity-broker",
                      "to": "identity-broker",
                      "label": "HTTP 403; no Key Vault call",
                      "line": "solid",
                      "arrow": "filled"
                    }
                  ]
                },
                {
                  "label": "exact grant is active",
                  "steps": [
                    {
                      "type": "message",
                      "from": "authorized-redemption",
                      "to": "keyvault-adapter",
                      "label": "ISecretRedemption.RedeemAsync(request)",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "keyvault-adapter",
                      "to": "key-vault",
                      "label": "GetSecretAsync(id, exact version)",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "key-vault",
                      "to": "keyvault-adapter",
                      "label": "Exact-version secret",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "keyvault-adapter",
                      "to": "authorized-redemption",
                      "label": "Short-lived SecretCredential",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "authorized-redemption",
                      "to": "authorized-redemption",
                      "label": "FindGrantsAsync again; compare exact revision",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "fragment",
                      "operator": "alt",
                      "label": "Post-acquisition grant check",
                      "sections": [
                        {
                          "label": "grant changed, postcheck errors, or cancellation",
                          "steps": [
                            {
                              "type": "message",
                              "from": "authorized-redemption",
                              "to": "authorized-redemption",
                              "label": "Invalidate acquired credential",
                              "line": "solid",
                              "arrow": "filled"
                            },
                            {
                              "type": "message",
                              "from": "authorized-redemption",
                              "to": "identity-broker",
                              "label": "Throw denial or propagate error/cancellation",
                              "line": "dashed",
                              "arrow": "open"
                            }
                          ]
                        },
                        {
                          "label": "same exact active grant",
                          "steps": [
                            {
                              "type": "message",
                              "from": "authorized-redemption",
                              "to": "authorized-redemption",
                              "label": "LimitLifetime(grant expiry)",
                              "line": "solid",
                              "arrow": "filled"
                            },
                            {
                              "type": "message",
                              "from": "authorized-redemption",
                              "to": "identity-broker",
                              "label": "Return credential",
                              "line": "dashed",
                              "arrow": "open"
                            },
                            {
                              "type": "message",
                              "from": "identity-broker",
                              "to": "identity-broker",
                              "label": "Write response; finally invalidate credential",
                              "line": "solid",
                              "arrow": "filled"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
