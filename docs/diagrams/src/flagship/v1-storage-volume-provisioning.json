{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Storage volumes, replacement, and Sandbox attachment",
  "alt": "Environment provisions a generation-pinned Azure Files claim and negotiates the selected Sandbox mount. Suspend saves trusted mounted flush evidence before release and exact detach. Resume validates saved private configuration before owner calls or effects. It prepares a new Sandbox with the same Storage resource and data generation. Core saves that exact mount before the Host hashes its actual tree and Environment repeats Network and owner checks. Post-fence bootstrap uses saved server configuration, a server-issued attempt, and fresh Host state and cache evidence. A saved receipt or generic failure cannot permit dispatch. These source contracts do not prove live durability, native TLS, or Azure erasure.",
  "autonumber": true,
  "participants": [
    {
      "id": "storage-caller",
      "label": "Environment Core + owner store",
      "subLabel": "Storage API and owner CAS",
      "icon": "server",
      "fluentIcon": "api",
      "badge": { "text": "Core", "tone": "neutral" }
    },
    {
      "id": "azure-files",
      "label": "Azure Files CSI",
      "subLabel": "Storage provider",
      "icon": "box",
      "fluentIcon": "package",
      "badge": { "text": "Provider", "tone": "teal" }
    },
    {
      "id": "kubernetes",
      "label": "Kubernetes API",
      "subLabel": "Storage, Pod, Service, Network",
      "icon": "box",
      "fluentIcon": "container",
      "library": "kubernetes",
      "badge": { "text": "Cluster", "tone": "marigold" }
    },
    {
      "id": "sandbox",
      "label": "Sandbox provider",
      "subLabel": "Placement and mounted AgentHost",
      "icon": "bot",
      "fluentIcon": "window",
      "badge": { "text": "Provider", "tone": "teal" }
    }
  ],
  "steps": [
    {
      "type": "note",
      "over": ["storage-caller", "azure-files"],
      "label": "Provider options contain identities and revision IDs, never credentials. Each volume generation pins its Kubernetes target identity."
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "azure-files",
      "label": "ProvisionAsync(spec, resourceGeneration, idempotencyKey)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "azure-files",
      "to": "kubernetes",
      "label": "Read StorageClass; ensure Environment- and generation-specific PVC",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "fragment",
      "operator": "alt",
      "label": "PVC provisioning",
      "sections": [
        {
          "label": "Pending, failed, or timeout",
          "steps": [
            {
              "type": "message",
              "from": "kubernetes",
              "to": "azure-files",
              "label": "Pending claim or operation failure",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "azure-files",
              "to": "storage-caller",
              "label": "Wait, then return an explicit condition/error",
              "line": "dashed",
              "arrow": "open"
            }
          ]
        },
        {
          "label": "Bound",
          "steps": [
            {
              "type": "message",
              "from": "kubernetes",
              "to": "azure-files",
              "label": "Bound PVC with actual UID and PV name",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "azure-files",
              "to": "kubernetes",
              "label": "Read PV; verify claim UID; apply reclaim policy with UID test",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "kubernetes",
              "to": "azure-files",
              "label": "PV claim identity and reclaim-policy readback",
              "line": "dashed",
              "arrow": "open"
            },
            {
              "type": "message",
              "from": "azure-files",
              "to": "storage-caller",
              "label": "WorkspaceVolumeResource(actual PVC UID, resourceGeneration, capabilities)",
              "line": "dashed",
              "arrow": "open"
            }
          ]
        }
      ]
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "sandbox",
      "label": "Get actual Sandbox resource and profile",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "sandbox",
      "to": "storage-caller",
      "label": "Actual Sandbox ID, generation, and capabilities",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "storage-caller",
      "label": "Negotiate mount, actual resources, fence, and data generation",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "storage-caller",
      "label": "Pin candidate to actual PVC UID, resourceGeneration, capabilities",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "storage-caller",
      "label": "Resolve current suspend Workspace; save exact next-generation request",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "azure-files",
      "label": "FlushAsync with pinned resource and trusted mounted callback",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "azure-files",
      "to": "kubernetes",
      "label": "Check exact PVC, PV, claim specification, and mount options",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "sandbox",
      "label": "Require current Core authority; deliver trusted mounted suspend",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "sandbox",
      "to": "storage-caller",
      "label": "Exact native-turn, cache, and Workspace flush receipts",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "azure-files",
      "to": "kubernetes",
      "label": "Recheck the same pinned resources after mounted flush",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "storage-caller",
      "label": "Recheck authority after SQL waits; save evidence and advance data once",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "storage-caller",
      "to": "sandbox",
      "label": "After manifest, private configuration, and release/detach checks: prepare same volume/data; save mount, then verify",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "sandbox",
      "to": "storage-caller",
      "label": "Exact hash + owner/Network checks; post-fence attempt uses saved config, fresh Host/cache proof",
      "line": "dashed",
      "arrow": "open"
    }
  ]
}
