{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Azure Retail price search and save",
  "alt": "Gateway proxies read-only Azure Retail price search and PlatformAdmin rate-card writes to Events & Sessions. For search, Events checks current Projects & Config authority before calling the fixed Azure Retail endpoint and returns no-store candidates without changing rate cards. For save, Gateway runs a bodyless PlatformAdmin check before streaming the 64 KiB body, Events rechecks authority and checks the canonical request digest for 200 replay, verifies one eligible 1K/1M tier-0 USD row per meter on miss, rechecks expiration and authority, and atomically saves the immutable card with a strong ETag.",
  "autonumber": true,
  "participants": [
    {
      "id": "gateway",
      "label": "Gateway",
      "subLabel": "Fixed public API route",
      "icon": "route",
      "badge": {
        "text": "API",
        "tone": "teal"
      }
    },
    {
      "id": "events",
      "label": "Events & Sessions",
      "subLabel": "Checks Projects before lookup",
      "icon": "server",
      "badge": {
        "text": "Owner",
        "tone": "lavender"
      }
    },
    {
      "id": "projects",
      "label": "Projects & Config",
      "subLabel": "Current membership and role assignments",
      "icon": "database",
      "badge": {
        "text": "Authority",
        "tone": "marigold"
      }
    },
    {
      "id": "retail",
      "label": "Azure Retail Prices",
      "subLabel": "Fixed HTTPS endpoint",
      "icon": "globe",
      "badge": {
        "text": "External",
        "tone": "green"
      }
    }
  ],
  "steps": [
    {
      "type": "fragment",
      "operator": "alt",
      "label": "Search or Save",
      "sections": [
        {
          "label": "Search: GET /api/v1/projects/{projectId}/model-pricing/azure-retail",
          "steps": [
            {
              "type": "message",
              "from": "gateway",
              "to": "events",
              "label": "Forward bearer, tenant, project ID, and query",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "projects",
              "label": "GET model-pricing-search (204 no-store or 403/502)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "retail",
              "label": "Search USD Foundry Models Consumption meters",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "gateway",
              "label": "200 typed result; Cache-Control: no-store",
              "line": "dashed",
              "arrow": "open"
            }
          ]
        },
        {
          "label": "Save: PUT /api/v1/platform/model-pricing/azure-retail/rate-cards/{id}/{version}",
          "steps": [
            {
              "type": "message",
              "from": "gateway",
              "to": "projects",
              "label": "Bodyless PlatformAdmin check before streaming body",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "gateway",
              "to": "events",
              "label": "Stream 64 KiB JSON body with bearer and tenant",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "projects",
              "label": "Check authority before body/store; check replay digest",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "retail",
              "label": "On miss: verify one eligible 1K/1M tier-0 USD row per meter",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "projects",
              "label": "Recheck token expiration and authority before insert",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "events",
              "to": "gateway",
              "label": "201/200 canonical card + ETag; 409/503 on change/error",
              "line": "dashed",
              "arrow": "open"
            }
          ]
        }
      ]
    }
  ]
}
