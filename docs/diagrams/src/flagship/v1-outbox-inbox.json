{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "PostgreSQL outbox producer and inbox consumer",
  "alt": "Independent caller-owned producer and consumer transactions using PostgresOutbox. EnqueueAsync stores the event with producer state; AdmitAsync applies effects only for Admitted, skips duplicates, and acknowledges consumer delivery only after commit. ClaimOneAsync can lease a selected event only when it is next in its stream. The generic caller lane does not imply one product host.",
  "autonumber": true,
  "participants": [
    {
      "id": "caller",
      "label": "Application caller",
      "subLabel": "Independent producer / consumer transaction roles",
      "icon": "server",
      "fluentIcon": "api",
      "badge": { "text": "Caller", "tone": "neutral" }
    },
    {
      "id": "outbox",
      "label": "PostgresOutbox",
      "subLabel": "Agentweaver.Persistence.Postgres library",
      "icon": "box",
      "fluentIcon": "state",
      "badge": { "text": "Library", "tone": "teal" }
    },
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "subLabel": "External database resource",
      "icon": "database",
      "fluentIcon": "state",
      "badge": { "text": "Resource", "tone": "green" }
    },
    {
      "id": "delivery-transport",
      "label": "Consumer delivery transport",
      "subLabel": "Caller-supplied delivery and acknowledgment boundary",
      "icon": "server",
      "fluentIcon": "event",
      "badge": { "text": "Transport", "tone": "neutral" }
    }
  ],
  "steps": [
    {
      "type": "note",
      "over": ["caller", "outbox"],
      "label": "Producer and consumer use independent caller-owned transactions; one shared caller lane does not imply one service."
    },
    {
      "type": "note",
      "over": ["caller", "outbox", "postgres"],
      "label": "ClaimOneAsync leases one requested event only when no earlier event in that stream is undelivered; otherwise it returns null."
    },
    {
      "type": "message",
      "from": "caller",
      "to": "postgres",
      "label": "Write domain state",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "caller",
      "to": "outbox",
      "label": "EnqueueAsync(connection, transaction, event)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "postgres",
      "label": "Insert outbox event and stream sequence",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "caller",
      "label": "StoredOutboxEvent",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "fragment",
      "operator": "alt",
      "label": "Producer transaction",
      "sections": [
        {
          "label": "domain write and enqueue succeed",
          "steps": [
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Commit state and event together",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        },
        {
          "label": "operation fails",
          "steps": [
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Rollback both writes",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        }
      ]
    },
    {
      "type": "message",
      "from": "delivery-transport",
      "to": "caller",
      "label": "Deliver event",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "caller",
      "to": "outbox",
      "label": "AdmitAsync(connection, transaction, consumerId, messageId)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "postgres",
      "label": "Insert inbox receipt or detect duplicate",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "caller",
      "label": "Admitted or Duplicate",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "fragment",
      "operator": "alt",
      "label": "Inbox disposition",
      "sections": [
        {
          "label": "Admitted",
          "steps": [
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Apply effects and optional enqueue",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Commit consumer transaction",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "caller",
              "to": "delivery-transport",
              "label": "Acknowledge delivery after commit",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        },
        {
          "label": "Duplicate",
          "steps": [
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Skip effects; commit transaction",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "message",
              "from": "caller",
              "to": "delivery-transport",
              "label": "Acknowledge delivery after commit",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        },
        {
          "label": "consumer transaction fails",
          "steps": [
            {
              "type": "message",
              "from": "caller",
              "to": "postgres",
              "label": "Rollback; do not acknowledge delivery",
              "line": "solid",
              "arrow": "filled"
            }
          ]
        }
      ]
    }
  ]
}
