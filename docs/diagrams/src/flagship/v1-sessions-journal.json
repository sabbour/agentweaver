{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Native Sessions journal and owner delivery",
  "alt": "Projects & Config validates current permission and accepted run selection. The Orchestrator persists typed gates, current grants and redacted PolicyEvaluation receipts; Events & Sessions pins the native PostgreSQL journal and presents messages at fenced turn boundaries. Its generic append still rejects PolicyEvaluation until the retained #1846 receipt consumer is implemented.",
  "autonumber": true,
  "participants": [
    {
      "id": "caller",
      "label": "Authorized\ncaller",
      "subLabel": "GUID sub + project_id + run_id",
      "icon": "globe",
      "fluentIcon": "person",
      "badge": {
        "text": "client",
        "tone": "neutral"
      }
    },
    {
      "id": "api",
      "label": "Events & Sessions\nHTTP host",
      "subLabel": "Unpublished service candidate",
      "icon": "server",
      "fluentIcon": "api",
      "badge": {
        "text": "service",
        "tone": "teal"
      }
    },
    {
      "id": "provider",
      "label": "Provider catalog +\nNative Sessions adapter",
      "subLabel": "Resolve, negotiate, pin, verify",
      "icon": "box",
      "fluentIcon": "package",
      "badge": {
        "text": "in-process",
        "tone": "lavender"
      }
    },
    {
      "id": "postgres",
      "label": "Events & Sessions\nPostgreSQL schema",
      "subLabel": "Journal, immutable run pin, outbox/inbox",
      "icon": "database",
      "fluentIcon": "state",
      "badge": {
        "text": "durable authority",
        "tone": "green"
      }
    }
  ],
  "steps": [
    {
      "type": "message",
      "from": "caller",
      "to": "api",
      "label": "POST /internal/sessions/{sessionId}",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "activation",
      "participant": "api",
      "action": "start"
    },
    {
      "type": "note",
      "over": ["caller", "api"],
      "label": "OpenIddict validates issuer/audience; host requires GUID sub and one active-grant project_id/run_id pair."
    },
    {
      "type": "note",
      "over": ["api", "postgres"],
      "label": "Runtime uses password-free workload identity and verifies schema only; --migrate uses a separate privileged connection and identity."
    },
    {
      "type": "message",
      "from": "api",
      "to": "provider",
      "label": "Resolve default or permitted project override",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "activation",
      "participant": "provider",
      "action": "start"
    },
    {
      "type": "message",
      "from": "provider",
      "to": "postgres",
      "label": "Verify owned schema and negotiate live database identity",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "postgres",
      "to": "provider",
      "label": "Confirmed database and resource generation",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "provider",
      "to": "api",
      "label": "Return pinned provider, options revision, resource, and capabilities",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "activation",
      "participant": "provider",
      "action": "end"
    },
    {
      "type": "message",
      "from": "api",
      "to": "postgres",
      "label": "Persist immutable project/run pin and session",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "postgres",
      "to": "api",
      "label": "Commit; return SessionRecord",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "api",
      "to": "caller",
      "label": "201 Created",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "activation",
      "participant": "api",
      "action": "end"
    },
    {
      "type": "note",
      "over": ["api", "provider", "postgres"],
      "label": "Later append, replay, and subscribe verify the stored exact pin. A changed/missing binding fails closed; a different create binding conflicts."
    },
    {
      "type": "message",
      "from": "caller",
      "to": "api",
      "label": "POST /internal/sessions/{sessionId}/events",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "note",
      "over": ["caller", "api"],
      "label": "PolicyEvaluation append denied; Orchestrator receipt consumer remains #1846 work."
    },
    {
      "type": "activation",
      "participant": "api",
      "action": "start"
    },
    {
      "type": "message",
      "from": "api",
      "to": "postgres",
      "label": "Verify run pin; admit run-scoped event ID",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "api",
      "to": "postgres",
      "label": "Advance run sequence; atomically write event, refs, and outbox",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "postgres",
      "to": "api",
      "label": "Commit before returning durable event",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "api",
      "to": "caller",
      "label": "201 new event; 200 identical retry",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "caller",
      "to": "api",
      "label": "GET /internal/projects/{projectId}/runs/{runId}/events[/live]",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "api",
      "to": "postgres",
      "label": "Read durable events after cursor; poll for live subscription",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "postgres",
      "to": "api",
      "label": "Run-ordered rows retaining session identity",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "message",
      "from": "api",
      "to": "caller",
      "label": "Page or NDJSON delivery: event + nextCursor",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "activation",
      "participant": "api",
      "action": "end"
    },
    {
      "type": "note",
      "over": ["caller", "api", "postgres"],
      "label": "Orchestrator validates the owner outbox; Events presents at fenced turn boundaries. Receipt is not approval."
    }
  ]
}
