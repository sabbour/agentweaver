{
  "$schema": "../sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Outbox relay lease and acknowledgment",
  "alt": "A caller explicitly invokes OutboxRelay.RelayOnceAsync; the library has no daemon. It claims leased events through PostgresOutbox, publishes through IOutboxPublisher, and acknowledges confirmed publishes with the current lease token. Failures remain reclaimable and delivery is at least once.",
  "autonumber": true,
  "participants": [
    {
      "id": "relay",
      "label": "OutboxRelay",
      "subLabel": "Agentweaver.Persistence.Postgres library",
      "icon": "box",
      "fluentIcon": "workflow",
      "badge": { "text": "Library", "tone": "teal" }
    },
    {
      "id": "outbox",
      "label": "PostgresOutbox",
      "subLabel": "Agentweaver.Persistence.Postgres library",
      "icon": "box",
      "fluentIcon": "state",
      "badge": { "text": "Library", "tone": "teal" }
    },
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "subLabel": "External database resource",
      "icon": "database",
      "fluentIcon": "state",
      "badge": { "text": "Resource", "tone": "green" }
    },
    {
      "id": "publisher",
      "label": "IOutboxPublisher",
      "subLabel": "Injected transport boundary",
      "icon": "box",
      "fluentIcon": "api",
      "badge": { "text": "Interface", "tone": "neutral" }
    }
  ],
  "steps": [
    {
      "type": "message",
      "from": "relay",
      "to": "outbox",
      "label": "ClaimAsync(workerId, batchSize, leaseDuration)",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "postgres",
      "label": "Lease earliest undelivered event per stream",
      "line": "solid",
      "arrow": "filled"
    },
    {
      "type": "message",
      "from": "outbox",
      "to": "relay",
      "label": "OutboxDelivery batch with lease tokens",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "fragment",
      "operator": "loop",
      "label": "each claimed delivery",
      "sections": [
        {
          "steps": [
            {
              "type": "message",
              "from": "relay",
              "to": "publisher",
              "label": "PublishAsync(event)",
              "line": "solid",
              "arrow": "filled"
            },
            {
              "type": "fragment",
              "operator": "alt",
              "label": "Publisher outcome",
              "sections": [
                {
                  "label": "publish confirmed",
                  "steps": [
                    {
                      "type": "message",
                      "from": "publisher",
                      "to": "relay",
                      "label": "Completed",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "outbox",
                      "label": "AcknowledgeAsync(eventId, leaseToken)",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "outbox",
                      "to": "postgres",
                      "label": "Mark delivered only for current unexpired token",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "outbox",
                      "to": "relay",
                      "label": "RelayOutcome.Acknowledged or AcknowledgmentFenced",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "fragment",
                      "operator": "alt",
                      "label": "Lease acknowledgment result",
                      "sections": [
                        {
                          "label": "true",
                          "steps": [
                            {
                              "type": "message",
                              "from": "relay",
                              "to": "relay",
                              "label": "RelayOutcome.Acknowledged",
                              "line": "solid",
                              "arrow": "filled"
                            }
                          ]
                        },
                        {
                          "label": "false; lease expired, replaced, or settled",
                          "steps": [
                            {
                              "type": "message",
                              "from": "relay",
                              "to": "relay",
                              "label": "RelayOutcome.AcknowledgmentFenced; at-least-once",
                              "line": "solid",
                              "arrow": "filled"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "publish throws",
                  "steps": [
                    {
                      "type": "message",
                      "from": "publisher",
                      "to": "relay",
                      "label": "Exception",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "relay",
                      "label": "PublishFailed; no ack; lease remains reclaimable",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "outbox",
                      "label": "Later RelayOnceAsync: ClaimAsync(...)",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "outbox",
                      "to": "relay",
                      "label": "Reclaimed delivery; fresh leaseToken",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "publisher",
                      "label": "Retry PublishAsync(event)",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "outbox",
                      "label": "AcknowledgeAsync(eventId, fresh leaseToken) after confirm",
                      "line": "solid",
                      "arrow": "filled"
                    }
                  ]
                },
                {
                  "label": "cancellation before acknowledgment",
                  "steps": [
                    {
                      "type": "message",
                      "from": "relay",
                      "to": "relay",
                      "label": "Propagate cancellation; skip acknowledgment",
                      "line": "solid",
                      "arrow": "filled"
                    },
                    {
                      "type": "note",
                      "over": ["relay", "outbox"],
                      "label": "A publish may finish externally and remain unacknowledged until lease expiry."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
