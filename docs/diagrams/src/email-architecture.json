    },
    {
      "from": "Catalog",
      "to": "Postgres",
      "label": "persists catalog + memory"
    },
    {
      "from": "Authorization",
      "to": "KeyVault",
      "label": "stores app secrets"
    },
    {
      "from": "Authorization",
      "to": "GitHub",
      "label": "brokers capabilities"
    },
    {
      "from": "GitServices",
      "to": "GitHub",
      "label": "clones + merges"
    },
    {
      "from": "AgentHost",
      "to": "Models",
      "label": "model turns"
    },
    {
      "from": "Executor",
      "to": "GitHub",
      "label": "repository access"
