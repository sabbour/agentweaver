<mxCell id="note-0" fluentRole="note" value="Separate Events profile: explicit image, identity, owners, TLS and Blob inputs. No deployment proof; private result TLS stays disabled." style="shape=note;html=1;whiteSpace=wrap;fillColor=#f8f4f1;strokeColor=#ece7e3;fontFamily=Segoe UI;fontSize=12;" parent="fluent-content" vertex="1"><mxGeometry x="520" y="224" width="992" height="54" as="geometry"/></mxCell>
<mxCell id="note-1" fluentRole="note" value="Native PostgreSQL is the host default. The host requires SessionsCapabilities.All and cannot select optional AgentSessions." style="shape=note;html=1;whiteSpace=wrap;fillColor=#f8f4f1;strokeColor=#ece7e3;fontFamily=Segoe UI;fontSize=12;" parent="fluent-content" vertex="1"><mxGeometry x="520" y="308" width="992" height="54" as="geometry"/></mxCell>
