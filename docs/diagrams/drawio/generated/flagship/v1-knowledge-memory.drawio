<mxCell id="note-12" fluentRole="note" value="Failure stays PENDING; caller retry uses fresh same-actor bearer(s). No background worker or token acquisition." style="shape=note;html=1;whiteSpace=wrap;fillColor=#f8f4f1;strokeColor=#ece7e3;fontFamily=Segoe UI;fontSize=12;" parent="fluent-content" vertex="1"><mxGeometry x="124" y="962" width="992" height="54" as="geometry"/></mxCell>
