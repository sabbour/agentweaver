<mxCell id="message-4-label" fluentRole="edge-label" value="&lt;div style=&quot;font-family:Segoe UI;font-size:16px;font-weight:600;line-height:1.15;&quot;&gt;4. GET /internal/accepted-effects/{receiptId} from fixed HTTPS origin; redirects disabled&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fdfbf8;strokeColor=#ece7e3;strokeWidth=1;shadow=0;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#3f3935;fontStyle=1;spacing=0;" parent="fluent-content" vertex="1"><mxGeometry x="218.39999999999998" y="436.8" width="803.2" height="30.4" as="geometry"/></mxCell>
