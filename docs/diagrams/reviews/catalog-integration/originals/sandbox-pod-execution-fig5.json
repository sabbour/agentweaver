{
  "$schema": "./sequence-spec.schema.json",
  "kind": "sequence",
  "title": "Provisioning heartbeat and coordinator stall exemption",
  "alt": "Sequence showing a coordinator dispatching a child run, the sandbox executor polling an unbound claim, periodic provisioning heartbeats resetting the coordinator stall window, and execution starting after the pod becomes ready",
  "autonumber": true,
  "participants": [
    {
      "id": "Coordinator",
      "label": "CoordinatorDispatchService",
      "subLabel": "child observation loop",
      "icon": "server",
      "badge": { "text": "Compute", "tone": "green" }
    },
    {
      "id": "Executor",
      "label": "KubernetesSandboxExecutor",
      "subLabel": "claim and bind wait",
      "icon": "server",
      "badge": { "text": "Service", "tone": "green" }
    },
    {
      "id": "Kubernetes",
      "label": "Kubernetes",
      "subLabel": "SandboxClaim + pod",
      "icon": "database",
      "badge": { "text": "Platform", "tone": "teal" }
    },
    {
      "id": "Events",
      "label": "Child run event stream",
      "icon": "box",
      "badge": { "text": "Events", "tone": "teal" }
    },
    {
      "id": "Child",
      "label": "Child run",
      "subLabel": "AgentHost execution",
      "icon": "bot",
      "badge": { "text": "Runtime", "tone": "green" }
    }
  ],
  "steps": [
    {
      "type": "message",
      "from": "Coordinator",
      "to": "Executor",
      "label": "dispatch subtask"
    },
    {
      "type": "activation",
      "participant": "Executor",
      "action": "start"
    },
    {
      "type": "message",
      "from": "Executor",
      "to": "Kubernetes",
      "label": "submit SandboxClaim"
    },
    {
      "type": "fragment",
      "operator": "loop",
      "label": "until claim Bound and pod Ready",
      "sections": [
        {
          "steps": [
            {
              "type": "message",
              "from": "Executor",
              "to": "Kubernetes",
              "label": "watch claim status"
            },
            {
              "type": "fragment",
              "operator": "alt",
              "label": "claim state",
              "sections": [
                {
                  "label": "pod still Pending",
                  "steps": [
                    {
                      "type": "message",
                      "from": "Kubernetes",
                      "to": "Executor",
                      "label": "not bound yet",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "Executor",
                      "to": "Events",
                      "label": "sandbox.provisioning_pending (~20 s)"
                    },
                    {
                      "type": "message",
                      "from": "Events",
                      "to": "Coordinator",
                      "label": "latest child event",
                      "line": "dashed",
                      "arrow": "open"
                    },
                    {
                      "type": "message",
                      "from": "Coordinator",
                      "to": "Coordinator",
                      "label": "reset subtask stall window"
                    }
                  ]
                },
                {
                  "label": "claim Bound; pod Ready",
                  "steps": [
                    {
                      "type": "message",
                      "from": "Kubernetes",
                      "to": "Executor",
                      "label": "AgentHost pod ready",
                      "line": "dashed",
                      "arrow": "open"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "message",
      "from": "Executor",
      "to": "Coordinator",
      "label": "sandbox ready",
      "line": "dashed",
      "arrow": "open"
    },
    {
      "type": "activation",
      "participant": "Executor",
      "action": "end"
    },
    {
      "type": "message",
      "from": "Coordinator",
      "to": "Child",
      "label": "execute child run"
    }
  ]
}
