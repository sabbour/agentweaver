        <mxCell id="heading" value="&lt;div style=&quot;font-size:27px;font-weight:600&quot;&gt;MCP trusts the broker, not GitHub&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#635c57;margin-top:12px&quot;&gt;OAuth and assistant turns obtain Agentweaver broker tokens; MCP and API validate independently.&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;fontFamily=Segoe UI;" vertex="1" parent="1">
