        <mxCell id="save-accent" value="" style="rounded=1;fillColor=#00666d;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="960" width="5" height="360" as="geometry" />
        </mxCell>
        <mxCell id="save-icon" value="" style="shape=document;fillColor=#a6e9ed;strokeColor=#00666d;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="129" y="1090" width="62" height="72" as="geometry" />
        </mxCell>
        <mxCell id="save-badge" value="PROJECT YAML" style="rounded=1;arcSize=100;fillColor=#a6e9ed;strokeColor=none;fontColor=#00666d;fontFamily=Segoe UI;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="980" width="235" height="38" as="geometry" />
        </mxCell>
        <mxCell id="explicit-save" value="Human chooses Save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#746d68;strokeWidth=2;fontFamily=Segoe UI;fontSize=21;fontColor=#3f3935;labelBackgroundColor=#fdfbf8;labelBorderColor=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="draft" target="save">
