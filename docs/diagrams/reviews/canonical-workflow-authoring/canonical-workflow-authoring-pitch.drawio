        </mxCell>
        <mxCell id="title" value="Workflow authoring" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=48;fontColor=#272320;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="60" width="990" height="68" as="geometry" />
        </mxCell>
        <mxCell id="takeaway" value="Generation produces a draft. Only explicit Save persists it." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=30;fontColor=#635c57;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="980" height="65" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="&lt;div style=&quot;font-size:38px;font-weight:600&quot;&gt;Generate &amp; review&lt;/div&gt;&lt;div style=&quot;font-size:29px;color:#635c57;margin-top:20px&quot;&gt;Provider-gated generation checks YAML and runtime bindability.&lt;br&gt;One correction is allowed; unresolved errors stop generation.&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#746d68;font-family:Cascadia Code;margin-top:20px&quot;&gt;Human reviews the valid YAML draft.&lt;br&gt;No workflow file is saved.&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdfbf8;strokeColor=#ece7e3;strokeWidth=1;shadow=1;align=left;spacingLeft=125;spacingRight=30;fontFamily=Segoe UI;fontColor=#272320;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="923" height="360" as="geometry" />
        </mxCell>
        <mxCell id="draft-accent" value="" style="rounded=1;fillColor=#3f3682;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="5" height="360" as="geometry" />
        </mxCell>
        <mxCell id="draft-icon" value="" style="shape=process;fillColor=#d2ccf8;strokeColor=#3f3682;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="129" y="460" width="62" height="72" as="geometry" />
        </mxCell>
        <mxCell id="draft-badge" value="UNSAVED DRAFT" style="rounded=1;arcSize=100;fillColor=#d2ccf8;strokeColor=none;fontColor=#3f3682;fontFamily=Segoe UI;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="350" width="235" height="38" as="geometry" />
        </mxCell>
        <mxCell id="save" value="&lt;div style=&quot;font-size:38px;font-weight:600&quot;&gt;Save &amp; register&lt;/div&gt;&lt;div style=&quot;font-size:29px;color:#635c57;margin-top:20px&quot;&gt;Explicit Save validates again, then writes inside the project workspace.&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#746d68;font-family:Cascadia Code;margin-top:20px&quot;&gt;Registry sync reloads the definition.&lt;br&gt;A reload failure returns an error.&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdfbf8;strokeColor=#ece7e3;strokeWidth=1;shadow=1;align=left;spacingLeft=125;spacingRight=30;fontFamily=Segoe UI;fontColor=#272320;" vertex="1" parent="1">
          <mxGeometry x="100" y="960" width="923" height="360" as="geometry" />
