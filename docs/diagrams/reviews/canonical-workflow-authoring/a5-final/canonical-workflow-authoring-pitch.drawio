          <mxGeometry x="66.9697" y="239.7101" width="32.187" height="37.5198" as="geometry" />
        </mxCell>
        <mxCell id="draft-badge" value="UNSAVED DRAFT" style="rounded=1;arcSize=100;fillColor=#d2ccf8;strokeColor=none;fontColor=#3f3682;fontFamily=Segoe UI;fontSize=11.4212;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="394.5503" y="182.3882" width="121.9991" height="19.8021" as="geometry" />
        </mxCell>
        <mxCell id="save" value="&lt;div style=&quot;font-size:19.7275px;font-weight:600&quot;&gt;Save &amp; register&lt;/div&gt;&lt;div style=&quot;font-size:15.0552px;color:#635c57;margin-top:10.3829px&quot;&gt;Explicit Save validates again, then writes inside the project workspace.&lt;/div&gt;&lt;div style=&quot;font-size:12.4595px;color:#746d68;font-family:Cascadia Code;margin-top:10.3829px&quot;&gt;Registry sync reloads the definition.&lt;br&gt;A reload failure returns an error.&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdfbf8;strokeColor=#ece7e3;strokeWidth=0.5191;shadow=1;align=left;spacingLeft=64.8931;spacingRight=15.5744;fontFamily=Segoe UI;fontColor=#272320;" vertex="1" parent="1">
