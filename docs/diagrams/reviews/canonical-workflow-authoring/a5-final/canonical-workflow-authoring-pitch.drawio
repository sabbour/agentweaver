        </mxCell>
        <mxCell id="draft" value="&lt;div style=&quot;font-size:19.7275px;font-weight:600&quot;&gt;Generate &amp; review&lt;/div&gt;&lt;div style=&quot;font-size:15.0552px;color:#635c57;margin-top:10.3829px&quot;&gt;Provider-gated generation checks YAML and runtime bindability.&lt;br&gt;One correction is allowed; unresolved errors stop generation.&lt;/div&gt;&lt;div style=&quot;font-size:12.4595px;color:#746d68;font-family:Cascadia Code;margin-top:10.3829px&quot;&gt;Human reviews the valid YAML draft.&lt;br&gt;No workflow file is saved.&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fdfbf8;strokeColor=#ece7e3;strokeWidth=0.5191;shadow=1;align=left;spacingLeft=64.8931;spacingRight=15.5744;fontFamily=Segoe UI;fontColor=#272320;" vertex="1" parent="1">
