{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentweaver.dev/schemas/blueprint-package-v1.json",
  "x-agentweaver-canonical-number-token-max-length": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "definitions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,63})(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "blueprint",
              "role",
              "workflow",
              "skill"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,63})(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "blueprint"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/blueprints/[a-z0-9](?:[a-z0-9-]{0,63})\\.json(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "role"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/roles/[a-z0-9](?:[a-z0-9-]{0,63})\\.json(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "workflow"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/workflows/[a-z0-9](?:[a-z0-9-]{0,63})\\.yaml(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "skill"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/skills/[a-z0-9](?:[a-z0-9-]{0,63})\\.md(?![\\s\\S])"
                }
              }
            }
          }
        ],
        "x-agentweaver-canonical-definition-path": true
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_agentweaver_version"
      ],
      "properties": {
        "minimum_agentweaver_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        },
        "maximum_agentweaver_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "catalog",
            "generated",
            "imported"
          ]
        },
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}(?![\\s\\S])"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?|\\[[0-9A-Fa-f:.]+\\])(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#](?:[A-Za-z0-9\\-._~:/?#[\\]@!$&'()*+,;=]|%[0-9A-Fa-f]{2})*)?(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}(?![\\s\\S])"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
        }
      }
    },
    "container_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "x-agentweaver-vocabulary": {
    "id": "https://agentweaver.dev/vocab/blueprint-package-v1",
    "required": true
  }
}
