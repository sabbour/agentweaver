{
  "$schema": "https://agentweaver.dev/metaschemas/blueprint-package-v1",
  "$id": "https://agentweaver.dev/schemas/blueprint-package-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "definitions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,63})(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "blueprint",
              "role",
              "workflow",
              "skill"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,63})(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "blueprint"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/blueprints/[a-z0-9](?:[a-z0-9-]{0,63})\\.json(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "role"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/roles/[a-z0-9](?:[a-z0-9-]{0,63})\\.json(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "workflow"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/workflows/[a-z0-9](?:[a-z0-9-]{0,63})\\.yaml(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "skill"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "^definitions/skills/[a-z0-9](?:[a-z0-9-]{0,63})\\.md(?![\\s\\S])"
                }
              }
            }
          }
        ],
        "x-agentweaver-canonical-definition-path": true
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_agentweaver_version"
      ],
      "properties": {
        "minimum_agentweaver_version": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        },
        "maximum_agentweaver_version": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "catalog",
            "generated",
            "imported"
          ]
        },
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}(?![\\s\\S])"
        },
        "repository": {
          "type": "string",
          "maxLength": 2048,
          "description": "Absolute HTTPS repository URI using the package lexical RFC 3986 profile.",
          "x-agentweaver-https-repository-uri": true
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}(?![\\s\\S])"
        },
        "created_at": {
          "type": "string",
          "x-agentweaver-rfc3339-timestamp": true
        }
      }
    },
    "container_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
